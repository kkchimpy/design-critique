# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Keys and secrets
# Note: this app takes the OpenRouter key from the browser UI, not a backend
# .env file. These entries only guard against anyone adding one locally.
.env
.env.*

# Local/generated app output. Keep folder structure via .gitkeep files,
# but do not track user-generated answers, pages, or conversations.
data/*
!data/conversations/
data/conversations/*
!data/conversations/.gitkeep

# Local agent customization
.agents/

# Generated static site output
_site/

# Token-optimizer runtime databases (local agent state, never commit)
token-optimizer/*.db
token-optimizer/*.db-shm
token-optimizer/*.db-wal
token-optimizer/sessions/

# OS metadata
.DS_Store
**/.DS_Store